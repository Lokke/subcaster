# ============================================
# SubCaster Docker Configuration
# ============================================
#
# WICHTIG: Diese Datei wird für Docker-Build benötigt!
#
# Zwei Möglichkeiten:
#
# 1. MINIMAL (Empfohlen für Setup-Wizard):
#    - Nur öffentliche VITE_* Variablen
#    - Secrets bleiben leer (werden später im Wizard gesetzt)
#    - Build funktioniert, Secrets kommen vom Backend
#
# 2. VOLLSTÄNDIG:
#    - Alle Variablen setzen (auch Secrets)
#    - Kein Setup-Wizard nötig
#    - Direkt einsatzbereit
#
# ============================================

# ============================================
# ÖFFENTLICHE CONFIG (für Frontend-Build)
# ============================================
# Diese Werte werden in den Build eingebettet

# Deck Configuration
VITE_DECK_CONFIGURATION=four-decks

# Streaming Settings
VITE_STREAM_BITRATE=128
VITE_STREAM_SAMPLE_RATE=44100

# Unified Login (optional)
VITE_USE_UNIFIED_LOGIN=false

# ============================================
# SERVER-CONFIG (öffentlich, URLs/IDs)
# ============================================

# OpenSubsonic (optional - kann leer bleiben für Wizard)
VITE_OPENSUBSONIC_URL=

# AzuraCast (optional - kann leer bleiben für Wizard)
VITE_AZURACAST_SERVERS=
VITE_AZURACAST_STATION_ID=1

# Discord Wishbox (optional - kann leer bleiben für Wizard)
VITE_DISCORD_CHANNEL_ID=
VITE_DISCORD_GUILD_ID=

# ============================================
# SECRETS (Server-only, OHNE VITE_ prefix)
# ============================================
# Diese Werte NICHT im Build, nur auf Server!
# Können leer bleiben - werden später gesetzt

# Unified Login Credentials
UNIFIED_USERNAME=
UNIFIED_PASSWORD=

# OpenSubsonic Credentials
OPENSUBSONIC_USERNAME=
OPENSUBSONIC_PASSWORD=

# AzuraCast DJ Credentials
AZURACAST_DJ_USERNAME=
AZURACAST_DJ_PASSWORD=

# Discord Bot Token (WICHTIG: Ohne VITE_ prefix!)
DISCORD_BOT_TOKEN=

# Streaming Credentials
STREAM_SERVER=
STREAM_PORT=8000
STREAM_USERNAME=
STREAM_PASSWORD=

# ============================================
# DOCKER/SERVER CONFIG
# ============================================
PROXY_PORT=3001
NODE_ENV=production
