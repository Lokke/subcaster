# Multi-stage build für optimierte Production-Image
FROM node:24.8.0-alpine AS builder

# Arbeitsverzeichnis setzen
WORKDIR /app

# Build args für Environment Variables
ARG VITE_DISCORD_BOT_TOKEN
ARG VITE_DISCORD_CHANNEL_ID
ARG VITE_DISCORD_GUILD_ID
ARG VITE_OPENSUBSONIC_URL
ARG VITE_OPENSUBSONIC_USERNAME
ARG VITE_OPENSUBSONIC_PASSWORD
ARG VITE_AZURACAST_SERVERS
ARG VITE_AZURACAST_STATION_ID
ARG VITE_AZURACAST_DJ_USERNAME
ARG VITE_AZURACAST_DJ_PASSWORD
ARG VITE_STREAM_BITRATE
ARG VITE_STREAM_SAMPLE_RATE
ARG VITE_DECK_CONFIGURATION
ARG VITE_USE_UNIFIED_LOGIN
ARG VITE_UNIFIED_USERNAME
ARG VITE_UNIFIED_PASSWORD

# Convert build args to environment variables for Vite
ENV VITE_DISCORD_BOT_TOKEN=$VITE_DISCORD_BOT_TOKEN
ENV VITE_DISCORD_CHANNEL_ID=$VITE_DISCORD_CHANNEL_ID
ENV VITE_DISCORD_GUILD_ID=$VITE_DISCORD_GUILD_ID
ENV VITE_OPENSUBSONIC_URL=$VITE_OPENSUBSONIC_URL
ENV VITE_OPENSUBSONIC_USERNAME=$VITE_OPENSUBSONIC_USERNAME
ENV VITE_OPENSUBSONIC_PASSWORD=$VITE_OPENSUBSONIC_PASSWORD
ENV VITE_AZURACAST_SERVERS=$VITE_AZURACAST_SERVERS
ENV VITE_AZURACAST_STATION_ID=$VITE_AZURACAST_STATION_ID
ENV VITE_AZURACAST_DJ_USERNAME=$VITE_AZURACAST_DJ_USERNAME
ENV VITE_AZURACAST_DJ_PASSWORD=$VITE_AZURACAST_DJ_PASSWORD
ENV VITE_STREAM_BITRATE=$VITE_STREAM_BITRATE
ENV VITE_STREAM_SAMPLE_RATE=$VITE_STREAM_SAMPLE_RATE
ENV VITE_DECK_CONFIGURATION=$VITE_DECK_CONFIGURATION
ENV VITE_USE_UNIFIED_LOGIN=$VITE_USE_UNIFIED_LOGIN
ENV VITE_UNIFIED_USERNAME=$VITE_UNIFIED_USERNAME
ENV VITE_UNIFIED_PASSWORD=$VITE_UNIFIED_PASSWORD

# Package-Dateien kopieren
COPY package*.json ./

# Alle Dependencies installieren (build braucht devDependencies)
RUN npm ci

# Source-Code kopieren
COPY . .

# Production build erstellen (mit Environment Variables)
RUN npm run build

# Production Stage
FROM node:24.8.0-alpine AS production

# Arbeitsverzeichnis setzen
WORKDIR /app

# System-Dependencies für Health-Check
RUN apk add --no-cache curl

# Package-Dateien kopieren für production install
COPY --from=builder /app/package*.json ./

# Nur Production-Dependencies installieren (postinstall Scripts deaktivieren)
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force

# Build-Artefakte kopieren
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/unified-server.js ./

# Non-root User erstellen
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001

# docker-data Verzeichnis erstellen und Ownership setzen
RUN mkdir -p /app/docker-data && \
    chown -R nodejs:nodejs /app/docker-data

# Ownership ändern
RUN chown -R nodejs:nodejs /app
USER nodejs

# Port freigeben
EXPOSE 3001

# Health-Check hinzufügen
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD curl -f http://localhost:3001/health || exit 1

# Server starten
CMD ["node", "unified-server.js"]