{
  "name": "subcaster",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "./",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Felix Pielok",
  "description": "Professional streaming and podcasting software with mixing capabilities",
  "scripts": {
    "dev": "concurrently \"npm run start:unified\" \"vite\"",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start:all": "concurrently \"npm run start:unified\" \"npm run dev\"",
    "start:unified": "node unified-server.js",
    "start:production": "node start-production.js",
    "stop:production": "node stop-production.js",
    "deploy:production": "node create-production-deployment.js",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:run": "npm run android:sync && npx cap run android",
    "android:build": "npm run build && npx cap sync android && cd android && ./gradlew assembleRelease",
    "android:build-debug": "npm run build && npx cap sync android && cd android && ./gradlew assembleDebug",
    "postinstall": "npx cap sync"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "concurrently": "^9.2.1",
    "http-server": "^14.1.1",
    "typescript": "~5.8.3",
    "vite": "^7.1.6"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/app": "^7.1.0",
    "@capacitor/cli": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@capacitor/filesystem": "^7.1.4",
    "@capacitor/network": "^7.0.2",
    "@types/three": "^0.180.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "http-proxy-middleware": "^3.0.5",
    "node-fetch": "^3.3.2",
    "three": "^0.180.0",
    "wavesurfer.js": "^7.10.1",
    "ws": "^8.18.3"
  }
}
